{
  "name": "@fever/api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@fever/environment",
    "@fever/types",
    "@fever/http",
    "@fever/shared"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "local": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sleep 5 && tsx --watch ./src/api/server.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
