{
  "name": "@fever/event-service",
  "version": "0.0.0",
  "private": true,
  "description": "Event service for Fever Event Platform",
  "author": "Fever",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@fever/api": "workspace:^",
    "@fever/environment": "workspace:^",
    "@fever/shared": "workspace:^",
    "@fever/types": "workspace:^",
    "bullmq": "^5.58.0",
    "express": "^5.1.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@fever/http": "workspace:^",
    "@fever/redis": "workspace:^",
    "@fever/tests": "workspace:^",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run tests/integration/",
    "test:performance": "npm run perf:full",
    "perf:smoke": "artillery run tests/performance/artillery-smoke.yml",
    "perf:load": "artillery run tests/performance/artillery-config.yml",
    "perf:full": "npm run perf:load -- --output tests/performance/results.json && npm run perf:visualize",
    "perf:visualize": "node tests/performance/visualize-results.js tests/performance/results.json",
    "perf:quick": "npm run perf:smoke -- --output tests/performance/smoke-results.json && node tests/performance/visualize-results.js tests/performance/smoke-results.json",
    "perf:open": "open tests/performance/results-report.html || xdg-open tests/performance/results-report.html 2>/dev/null || start tests/performance/results-report.html 2>/dev/null",
    "perf:clean": "rm -f tests/performance/*.json tests/performance/*.html",
    "perf:generate-data": "tsx tests/performance/generate-test-data.ts",
    "perf:all": "npm run perf:clean && npm run perf:quick && npm run perf:full && npm run perf:open"
  }
}
