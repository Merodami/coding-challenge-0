{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declarationDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@event-service/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["../../node_modules", "node_modules"],
  "references": [
    {
      "path": "../../types"
    },
    {
      "path": "../../environment"
    },
    {
      "path": "../../shared"
    },
    {
      "path": "../../database"
    },
    {
      "path": "../../redis"
    },
    {
      "path": "../../tests"
    }
  ]
}
