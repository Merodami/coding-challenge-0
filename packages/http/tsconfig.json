{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": true,
    "declarationDir": "dist",
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@http/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "../../node_modules", "node_modules"],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../environment"
    },
    {
      "path": "../shared"
    },
    {
      "path": "../redis"
    }
  ]
}
