{
  "name": "@fever/api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["@fever/types"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "outputs": ["{projectRoot}/dist"],
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsc -p tsconfig.build.json --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "local": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
          "tsc-alias -p tsconfig.build.json --watch"
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    },
    "open:docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open dist/api-docs-index.html",
        "cwd": "{projectRoot}"
      }
    },
    "open-docs-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open dist/all-apis-docs.html",
        "cwd": "{projectRoot}"
      }
    },
    "open-docs-zod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open dist/openapi-zod.html",
        "cwd": "{projectRoot}"
      }
    },
    "compare-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open compare-docs.html",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest watch",
        "cwd": "{projectRoot}"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "{projectRoot}"
      }
    },
    "generate:openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/scripts/generate-openapi.ts",
        "cwd": "{projectRoot}"
      }
    },
    "generate:docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/scripts/generate-docs.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
