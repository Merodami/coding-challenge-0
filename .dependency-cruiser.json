{
  "forbidden": [
    {
      "name": "no-circular",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "node_modules|dist"
    },
    "exclude": {
      "path": "node_modules|dist|build|coverage|reports|\\.next|\\.turbo|packages/tests/performance"
    },
    "tsPreCompilationDeps": true,
    "enhancedResolveOptions": {
      "exportsFields": ["exports"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "includeOnly": "\\.(ts|tsx)$"
  }
}
