# Test Environment Configuration for Fever Event Service
# This file contains environment variables for running tests

# ===========================================
# Basic Configuration
# ===========================================

NODE_ENV=test
ENV_STAGE=test
LOG_LEVEL=error
APP_NAME=Fever-Event-Service
APP_VERSION=0.1.0
BASE_URL=http://127.0.0.1:5500
API_PREFIX=/api/v1
HOST=0.0.0.0
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_CURRENCY=EUR

# ===========================================
# Event Service Configuration
# ===========================================

EVENT_SERVICE_NAME=event_service
EVENT_API_URL=http://127.0.0.1:5520
EVENT_SERVICE_PORT=5520
EVENT_SERVICE_HOST=0.0.0.0

# ===========================================
# External Provider Configuration
# ===========================================

PROVIDER_API_URL=https://provider.code-challenge.feverup.com/api/events
PROVIDER_API_TIMEOUT=5000
PROVIDER_TIMEOUT=5000
PROVIDER_SYNC_INTERVAL=300000
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_DELAY=1000
PROVIDER_CACHE_TTL=300

# ===========================================
# Circuit Breaker Configuration
# ===========================================

CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
CIRCUIT_BREAKER_ROLLING_COUNT_TIMEOUT=10000

# ===========================================
# Database Configuration (Test)
# ===========================================

PG_HOST=127.0.0.1
PG_PORT=5436
PG_DATABASE=fever_events_test
PG_USER=fever_test
PG_PASSWORD=fever_test
PG_SSL=false
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=2000
DATABASE_URL=postgresql://fever_test:fever_test@127.0.0.1:5436/fever_events_test?schema=public

# ===========================================
# Redis Configuration (Test)
# ===========================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_PREFIX=fever_test:
REDIS_DEFAULT_TTL=300
REDIS_EVENT_CACHE_TTL=300
REDIS_RETRY_DELAY=50
REDIS_MAX_RETRY_DELAY=2000
CACHE_DISABLED=false
CACHE_TYPE=redis

# ===========================================
# Queue Configuration (BullMQ - uses Redis)
# ===========================================

# Queue Job Settings
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000 # 5 seconds
QUEUE_COMPLETED_JOBS_COUNT=100
QUEUE_COMPLETED_JOBS_AGE=86400 # 24 hours in seconds
QUEUE_FAILED_JOBS_COUNT=500
QUEUE_FAILED_JOBS_AGE=604800 # 7 days in seconds

# Queue Worker Settings
QUEUE_WORKER_CONCURRENCY=1
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION=60000 # 1 minute in milliseconds

# Queue Redis Keys and TTLs
QUEUE_LAST_SYNC_KEY=event-service:last-sync
QUEUE_LAST_SYNC_TTL=86400 # 24 hours in seconds

# Enable queue in test environment (set to false to disable background jobs in tests)
ENABLE_QUEUE_IN_TEST=false

# ===========================================
# Security Configuration
# ===========================================

API_KEY=test-fever-api-key
API_KEY_HEADER=x-api-key
REQUIRE_API_KEY=true
SERVICE_API_KEY=test-internal-service-key

# ===========================================
# Rate Limiting (Disabled for Tests)
# ===========================================

RATE_LIMIT_ENABLE=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# API Gateway Configuration
# ===========================================

API_GATEWAY_PORT=5500
API_GATEWAY_BASE_URL=http://127.0.0.1:5500
SERVICE_HOST=0.0.0.0
CORS_ORIGIN=*
ENABLE_HELMET=false
ENABLE_CORS=true
ENABLE_COMPRESSION=false


# ===========================================
# Pagination
# ===========================================

PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Caching Strategy
CACHE_EVENTS_TTL=300
CACHE_PROVIDER_RESPONSE_TTL=300
CACHE_SEARCH_RESULTS_TTL=60

# ===========================================
# API Documentation
# ===========================================

API_DOCS_ENABLED=false
API_DOCS_PATH=/docs
API_DOCS_TITLE="Fever Event Service API"
API_DOCS_VERSION=1.0.0
OPENAPI_SERVER_URL=http://127.0.0.1:5500

# ===========================================
# Testing Configuration
# ===========================================

CI=true
EMBEDDED_MODE=false
DEBUG=false
TEST_VERBOSE=false
