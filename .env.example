# ===========================================
# Application Configuration
# ===========================================

# Environment
NODE_ENV=development
ENV_STAGE=local
LOG_LEVEL=debug
APP_NAME=fever-event-service
APP_VERSION=1.0.0
BASE_URL=http://localhost:5500
API_PREFIX=/api/v1
HOST=0.0.0.0
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=EUR

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL
DATABASE_URL=postgresql://fever:fever@localhost:5435/fever_events?schema=public
PG_HOST=localhost
PG_PORT=5435
PG_DATABASE=fever_events
PG_USER=fever
PG_PASSWORD=fever
PG_SSL=false
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=2000

# ===========================================
# Redis Cache Configuration
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_PREFIX=fever
REDIS_DEFAULT_TTL=300
REDIS_RETRY_DELAY=1000
REDIS_MAX_RETRY_DELAY=5000
CACHE_DISABLED=false
CACHE_TYPE=redis
REDIS_EVENT_CACHE_TTL=300

# ===========================================
# API Gateway & Service Ports
# ===========================================

# API Gateway
API_GATEWAY_PORT=5500
API_GATEWAY_BASE_URL=http://localhost:5500
SERVICE_HOST=localhost

# Event Service
EVENT_SERVICE_NAME=event-service
EVENT_SERVICE_PORT=5501
EVENT_SERVICE_HOST=localhost
EVENT_API_URL=http://localhost:5501/api/v1

# ===========================================
# Circuit Breaker Configuration
# ===========================================

# Circuit breaker settings for external service calls
# Timeout must be long enough to allow all retries to complete
CIRCUIT_BREAKER_TIMEOUT=120000 # 120 seconds to allow for retries
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=10
CIRCUIT_BREAKER_ROLLING_COUNT_TIMEOUT=10000

# ===========================================
# External Provider Configuration
# ===========================================

# Provider API
PROVIDER_API_URL=https://provider.code-challenge.feverup.com/api/events
PROVIDER_SYNC_INTERVAL=60000 # 1 minute in milliseconds
PROVIDER_API_TIMEOUT=10000 # 10 seconds
PROVIDER_TIMEOUT=10000 # 10 seconds
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_DELAY=1000 # 1 second
PROVIDER_CACHE_TTL=300 # 5 minutes

# ===========================================
# Queue Configuration (BullMQ)
# ===========================================

# Queue Job Settings
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000 # 5 seconds
QUEUE_COMPLETED_JOBS_COUNT=100
QUEUE_COMPLETED_JOBS_AGE=86400 # 24 hours in seconds
QUEUE_FAILED_JOBS_COUNT=500
QUEUE_FAILED_JOBS_AGE=604800 # 7 days in seconds

# Queue Worker Settings
QUEUE_WORKER_CONCURRENCY=1
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION=60000 # 1 minute in milliseconds

# Queue Redis Keys and TTLs
QUEUE_LAST_SYNC_KEY=event-service:last-sync
QUEUE_LAST_SYNC_TTL=86400 # 24 hours in seconds

# Enable queue in test environment (set to false to disable background jobs in tests)
ENABLE_QUEUE_IN_TEST=false

# ===========================================
# API Security
# ===========================================
# DEFAULT VALUES FOR POC - DO NOT USE IN PRODUCTION!
# For production, generate secure keys: openssl rand -hex 32

# API Key Protection (for PoC testing)
API_KEY=fever-poc-api-key-2025
API_KEY_HEADER=x-api-key
REQUIRE_API_KEY=true # Security enabled, but using default key for PoC
SERVICE_API_KEY=fever-internal-service-key-2025

# Rate Limiting
RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_WINDOW_MS=60000

# CORS (configure for your frontend domain)
CORS_ORIGIN=* # Change to specific domain in production
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_COMPRESSION=true

# ===========================================
# Pagination & Query Limits
# ===========================================

PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Caching Strategy
CACHE_EVENTS_TTL=300 # 5 minutes
CACHE_PROVIDER_RESPONSE_TTL=300 # 5 minutes
CACHE_SEARCH_RESULTS_TTL=60 # 1 minute

# ===========================================
# API Documentation
# ===========================================

API_DOCS_ENABLED=true
API_DOCS_PATH=/docs
API_DOCS_TITLE="Fever Event Service API"
API_DOCS_VERSION=1.0.0
OPENAPI_SERVER_URL=http://localhost:5500

# ===========================================
# Testing & Debug Configuration
# ===========================================

# CI/CD Environment
CI=false

# Debug & Testing (set to true for verbose logging in tests)
DEBUG=false
TEST_VERBOSE=false

# Embedded Mode
EMBEDDED_MODE=true