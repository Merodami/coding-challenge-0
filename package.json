{
  "name": "fever-event-service",
  "version": "1.0.0",
  "private": true,
  "description": "Microservice for integrating external provider events into Fever marketplace",
  "author": "Fever",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeverCodeChallenge/-Damian-Meroni.git"
  },
  "homepage": "https://github.com/FeverCodeChallenge/-Damian-Meroni#readme",
  "bugs": {
    "url": "https://github.com/FeverCodeChallenge/-Damian-Meroni/issues"
  },
  "scripts": {
    "validate:all": "yarn typecheck && yarn lint",
    "validate:everything": "yarn validate:all",
    "check": "yarn typecheck && yarn format:check && yarn lint",
    "check:fix": "yarn format && yarn lint:fix && yarn typecheck",
    "pre-commit": "yarn format && yarn lint:fix && yarn typecheck && yarn build",
    "graph": "nx graph",
    "docker:local": "docker compose -f docker-compose.local.yml up -d --quiet-pull",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "docker:restart": "yarn docker:local:down && yarn docker:local",
    "test": "yarn kill:processes && yarn vitest",
    "test:coverage": "yarn kill:processes && yarn vitest --run --coverage",
    "test:integration": "yarn vitest \"**/*.integration.test.ts\"",
    "test:all": "yarn test",
    "build": "nx run-many --target=build --all --parallel=100 --output-style=stream --skip-nx-cache",
    "build:vercel": "yarn build",
    "typecheck": "nx run-many --target=typecheck --parallel=100",
    "lint": "nx format:check && eslint '**/*.{js,tsx,jsx,ts}' && prettier --check .",
    "lint:fix": "prettier --write . && eslint '**/*.{js,tsx,jsx,ts}' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:report": "eslint --quiet --output-file eslint_report.json --format json '**/*.{js,tsx,jsx,ts}'",
    "quality": "yarn quality:type-coverage && yarn quality:circular && yarn quality:duplicates",
    "quality:type-coverage": "type-coverage --detail --strict --project tsconfig.json",
    "quality:type-coverage:report": "typescript-coverage-report --threshold 90 --outputDir reports/type-coverage",
    "quality:circular": "dependency-cruiser --validate .dependency-cruiser.json packages/",
    "quality:duplicates": "jscpd packages/ --reporters html --output reports/duplicates",
    "quality:bundle-size": "size-limit",
    "quality:unused": "knip",
    "quality:all": "yarn quality && yarn quality:bundle-size && yarn quality:unused",
    "local:generate": "yarn db:generate && nx run-many --target=build --projects=@fever/types,@fever/environment --skip-nx-cache && yarn generate:api && yarn generate:docs && yarn db:migrate",
    "local": "nx run-many --target=local --verbose --parallel=100 --output-style=stream",
    "reset:codebase": "yarn nx reset && yarn clear && yarn cache clear",
    "kill": "yarn kill:backend; yarn kill:processes",
    "kill:backend": "fkill --force --silent :5500 :5501 :5502 :5503 :5504 :5505",
    "kill:processes": "pkill -9 -f 'node.*vitest' || true; echo '✅ All vitest and node processes killed'",
    "db:generate": "nx run @fever/database:prisma:generate",
    "db:migrate:reset": "npx prisma migrate reset --schema packages/database/prisma/schema.prisma --force",
    "db:migrate": "nx run @fever/database:prisma:migrate:dev",
    "db:migrate:deploy": "npx prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "nx run @fever/database:prisma:seed",
    "db:reset:force": "docker stop fever_postgres 2>/dev/null; docker rm fever_postgres 2>/dev/null; rm -rf .local/data/postgres; docker-compose -f docker-compose.local.yml up -d postgres && sleep 5 && cd packages/database && npx dotenv -e ../../.env -- npx prisma migrate reset --force --skip-seed && cd ../..",
    "clear": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' + && find . -name \"dist\" -type d -prune -exec rm -rf '{}' +",
    "generate": "yarn generate:api && yarn generate:docs",
    "generate:api": "nx run @fever/api:generate:openapi && nx run @fever/api:build",
    "generate:docs": "nx run @fever/api:generate:docs",
    "sync:provider": "tsx packages/services/event/src/scripts/sync-provider.ts",
    "git-hooks-prepare": "husky install",
    "open:docs": "nx run @fever/api:open:docs",
    "test:smoke": "yarn tsx scripts/smoke-tests.ts",
    "perf:smoke": "artillery run packages/tests/performance/artillery-smoke.yml --output packages/tests/performance/smoke-results.json",
    "perf:load": "artillery run packages/tests/performance/artillery-config.yml --output packages/tests/performance/load-test-results.json",
    "perf:quick": "yarn perf:smoke && yarn perf:report:smoke",
    "perf:full": "yarn perf:load && yarn perf:report:load",
    "perf:report:smoke": "node packages/tests/performance/visualize-results.cjs packages/tests/performance/smoke-results.json",
    "perf:report:load": "node packages/tests/performance/visualize-results.cjs packages/tests/performance/load-test-results.json",
    "perf:report": "yarn perf:report:load",
    "perf:visualize": "node packages/tests/performance/visualize-results.cjs",
    "perf:open": "open packages/tests/performance/load-test-results-report.html || xdg-open packages/tests/performance/load-test-results-report.html || start packages/tests/performance/load-test-results-report.html",
    "perf:clean": "rm -f packages/tests/performance/*.json packages/tests/performance/*.html",
    "perf:generate-data": "tsx packages/tests/performance/generate-test-data.ts",
    "perf:all": "yarn perf:clean && yarn perf:full && yarn perf:open",
    "test:performance": "yarn perf:quick"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@nx/node": "^21.4.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/accepts": "^1.3.7",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "artillery": "^2.0.24",
    "axios": "^1.11.0",
    "concurrently": "^9.2.0",
    "dependency-cruiser": "^17.0.1",
    "dotenv": "^17.2.1",
    "dotenv-cli": "^10.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "eslint-plugin-vitest": "^0.5.4",
    "fix-esm-import-path": "^1.10.3",
    "fkill-cli": "^8.0.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^5.62.0",
    "lint-staged": "^16.1.5",
    "nx": "^21.4.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "6.14.0",
    "size-limit": "^11.2.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.4",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "typescript-coverage-report": "^1.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/**",
    "tools/**"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{js,ts,tsx,jsx}": []
  }
}
